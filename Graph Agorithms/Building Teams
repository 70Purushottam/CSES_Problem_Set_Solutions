#include <bits/stdc++.h>
using namespace std;

int bfs(vector<int> adj[],int i, int n, vector<int>& parent){
    
    queue<int> q;
 
    q.push(i);
    
    int flag = 0;
    parent[i] = 1;
    while(!q.empty()){
        
     int node = q.front();
     
     q.pop();
     
     for(auto it : adj[node]){
           if(parent[it] == -1){ 
               if(parent[node] == 2) parent[it] = 1;
               else parent[it] = 2;
             q.push(it);
           }
           else if(parent[node] == parent[it]) {
               flag = 1;
               break;
           }
     }
    }
  if(flag == 1)  return 0; 
  return 1;
}
int main() {
	// your code goes here
int n,m;
cin>>n>>m;
vector<int> adj[n+1];
 
for(int i=0;i<m;i++){
    int x,y;
    cin>>x>>y;
    adj[x].push_back(y);
    adj[y].push_back(x);
}
vector<int> parent(n+1, -1);

for(int i=1;i<=n;i++){
if(parent[i] == -1){
if(bfs(adj, i, n, parent) == 0) {cout<<"IMPOSSIBLE"<<"\n"; return 0;}
}
}
for(int i=1;i<=n;i++){
    if(parent[i] == -1) parent[i] = 1;
    cout<<parent[i]<<" ";
}
}
